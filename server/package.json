{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --import ./src/dotenv.config.ts src/app.ts",
    "start": "node --import ./dist/dotenv.config.js dist/app.js",
    "seed": "tsx --import ./src/dotenv.config.ts src/scripts/seed.ts",
    "apply-rule-queue": "tsx --import ./src/dotenv.config.ts src/scripts/apply-rule-queue.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.12",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2"
  }
}
